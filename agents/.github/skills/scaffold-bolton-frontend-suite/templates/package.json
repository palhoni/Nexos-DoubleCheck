{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npx playwright test --grep-invert \"@opt-in\"",
    "test:headed": "npx playwright test --headed --grep-invert \"@opt-in\"",
    "test:debug": "npx playwright test --debug",
    "test:allure": "npx playwright test --reporter=list,allure-playwright --grep-invert \"@opt-in\"",
    "test:smoke": "npx playwright test --grep \"@smoke\"",
    "test:security": "npx playwright test --grep \"@security\"",
    "test:authz": "npx playwright test --grep \"@authz\" --grep-invert \"@opt-in\"",
    "test:validation": "npx playwright test --grep \"@validation\"",
    "test:ux": "npx playwright test --grep \"@ux\"",
    "test:boundary": "npx playwright test --grep \"@boundary\"",
    "test:idempotency": "npx playwright test --grep \"@idempotency\"",
    "test:performance": "npx playwright test --grep \"@performance\"",
    "test:regression": "npx playwright test --grep \"@regression\"",
    "test:create": "npx playwright test --grep \"@create\"",
    "test:exclude": "npx playwright test --grep-invert",
    "test:wip": "npx playwright test --grep \"@wip\" --headed --workers=1 --trace=on",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.7.0",
    "allure-commandline": "^2.26.0",
    "allure-playwright": "^3.8.0",
    "dotenv": "^16.0.0",
    "typescript": "^5.5.0"
  }
}

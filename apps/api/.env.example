DATABASE_URL="postgresql://nexus_api:<senha-forte-local>@localhost:5432/doublecheck?schema=public"

JWT_ACCESS_SECRET="<gerar com: openssl rand -hex 32>"
JWT_ACCESS_EXPIRES_IN="8h"

WEB_ORIGIN="http://localhost:5173"
PORT=3000

# Chave da API da Anthropic (Claude), usada pelos Agents de IA.
# OPCIONAL: se não for definida, o backend usa automaticamente o Claude Agent SDK,
# que reaproveita a sessão local já autenticada do Claude Code (sem key nenhuma) —
# ótimo para rodar localmente, mas só funciona numa máquina com `claude` logado.
# Em produção/staging (sem sessão interativa do Claude Code), defina a key aqui.
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL_DEFAULT="claude-opus-5"
AGENT_EFFORT_DEFAULT="high"
AGENT_MAX_OUTPUT_TOKENS=32000
# 'auto' (default) usa a API key se existir e cai para a sessão do Claude Code se não
# existir. Force com 'api-key' ou 'claude-code-session' se quiser ignorar essa detecção.
# AGENT_AUTH_MODE="auto"

# Limite total para análises longas dos Agents (15 minutos por padrão)
AGENT_TIMEOUT_MS=900000

SEED_ADMIN_EMAIL="admin@nexus.local"
SEED_ADMIN_PASSWORD="NexusAdmin123!"
SEED_ADMIN_NOME="Administrador do Piloto"

SEED_AGENT_EMAIL="agent_ia@teste.com"
SEED_AGENT_PASSWORD="Caete@1234"
SEED_AGENT_NOME="Agent IA"

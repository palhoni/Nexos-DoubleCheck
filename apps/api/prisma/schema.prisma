// Nexus 2.0 — schema Prisma (Fase 2: Produto Real)
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  nome              String
  passwordHash      String                  @map("password_hash")
  isActive          Boolean                 @default(true) @map("is_active")
  createdAt         DateTime                @default(now()) @map("created_at")
  historyEntries    HistoryEntry[]
  documentosCriados DocumentoConhecimento[] @relation("DocumentoCriadoPor")
  documentoVersoes  DocumentoVersao[]       @relation("DocumentoVersaoCriadoPor")
  agentExecutions   AgentExecution[]

  @@map("users")
}

enum ProjetoStatus {
  Ativo
  Planejamento
  Inativo

  @@map("projeto_status")
}

model Projeto {
  id                   String        @id @default(cuid())
  nome                 String
  codigo               String        @unique
  status               ProjetoStatus @default(Ativo)
  descricao            String?
  objetivo             String?
  areaNegocio          String?       @map("area_negocio")
  idiomas              String[]      @default([])
  dataInicio           DateTime?     @map("data_inicio") @db.Date
  responsavelPrincipal String?       @map("responsavel_principal")
  jiraRef              String?       @map("jira_ref")
  confluenceRef        String?       @map("confluence_ref")
  observacoes          String?
  paisesDisponiveis    String[]      @default([]) @map("paises_disponiveis")
  fontesGerais         String[]      @default([]) @map("fontes_gerais")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  times                  Time[]
  pessoas                Pessoa[]
  produtos               Produto[]
  fontesConhecimento     FonteConhecimento[]     @relation("FonteProjetoProprietario")
  fonteVinculos          FonteVinculo[]          @relation("FonteVinculoProjetoContexto")
  documentosConhecimento DocumentoConhecimento[] @relation("DocumentoProjetoProprietario")
  documentoVinculos      DocumentoVinculo[]      @relation("DocumentoVinculoProjetoContexto")
  agentExecutions        AgentExecution[]
  endpointBacklogs       EndpointBacklog[]
  bugs                   Bug[]

  @@index([status])
  @@index([areaNegocio])
  @@map("projetos")
}

model AgentExecution {
  id             String    @id
  agent          String
  provider       String
  projetoId      String    @map("projeto_id")
  projeto        Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  actorUserId    String    @map("actor_user_id")
  actorUser      User      @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  titulo         String?
  requisito      String    @db.Text
  status         String
  phase          String
  progress       Int       @default(0)
  message        String
  partialContent String    @default("") @map("partial_content") @db.Text
  result         Json?
  error          String?   @db.Text
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  endpointBacklog EndpointBacklog?
  bugs            Bug[]

  @@index([actorUserId, createdAt])
  @@index([projetoId, createdAt])
  @@index([status])
  @@map("agent_executions")
}

enum EndpointDecisao {
  Pendente
  Automatizar
  Adiar
  NaoAutomatizar
  Investigar

  @@map("endpoint_decisao")
}

model EndpointBacklog {
  id          String         @id @default(cuid())
  projetoId   String         @map("projeto_id")
  projeto     Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  executionId String         @unique @map("execution_id")
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  sistema     String
  fontes      String[]       @default([])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  itens EndpointBacklogItem[]

  @@index([projetoId, createdAt])
  @@map("endpoint_backlogs")
}

model EndpointBacklogItem {
  id                   String          @id @default(cuid())
  backlogId            String          @map("backlog_id")
  backlog              EndpointBacklog @relation(fields: [backlogId], references: [id], onDelete: Cascade)
  codigo               String
  metodo               String
  endpoint             String
  descricao            String          @db.Text
  autenticacao         String
  prioridade           String
  criterioPrioridade   String          @db.Text @map("criterio_prioridade")
  observadoEm          String[]        @default([]) @map("observado_em")
  notas                String?         @db.Text
  decisao              EndpointDecisao @default(Pendente)
  decisaoJustificativa String?         @db.Text @map("decisao_justificativa")
  decididoPorUserId    String?         @map("decidido_por_user_id")
  decididoEm           DateTime?       @map("decidido_em")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@unique([backlogId, codigo])
  @@index([backlogId])
  @@map("endpoint_backlog_items")
}

enum BugSeveridade {
  Critical
  High
  Medium
  Low

  @@map("bug_severidade")
}

enum BugStatus {
  Aberto
  Corrigido
  Invalidado

  @@map("bug_status")
}

model Bug {
  id                    String         @id @default(cuid())
  projetoId             String         @map("projeto_id")
  projeto               Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  executionId           String         @map("execution_id")
  execution             AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  codigo                String
  titulo                String
  tcIdRelacionado       String?        @map("tc_id_relacionado")
  severidade            BugSeveridade
  prioridadeSugerida    String?        @map("prioridade_sugerida")
  ambiente              String?
  descricao             String         @db.Text
  passosReproducao      String[]       @default([]) @map("passos_reproducao")
  resultadoObtido       String         @db.Text @map("resultado_obtido")
  resultadoEsperado     String         @db.Text @map("resultado_esperado")
  evidenciaTecnica      Json?          @map("evidencia_tecnica")
  criterioAceiteViolado String?        @db.Text @map("criterio_aceite_violado")
  notasAdicionais       String?        @db.Text @map("notas_adicionais")
  status                BugStatus      @default(Aberto)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@unique([projetoId, codigo])
  @@index([projetoId, createdAt])
  @@index([status])
  @@map("bugs")
}

enum TimeStatus {
  Ativo
  Inativo

  @@map("time_status")
}

model Time {
  id                   String     @id @default(cuid())
  projetoId            String     @map("projeto_id")
  projeto              Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome                 String
  missao               String?    @map("missao")
  descricao            String?
  responsavelPrincipal String?    @map("responsavel_principal")
  paisesAtuacao        String[]   @default([]) @map("paises_atuacao")
  canaisComunicacao    String[]   @default([]) @map("canais_comunicacao")
  produtosAtendidos    String[]   @default([]) @map("produtos_atendidos")
  observacoes          String?
  status               TimeStatus @default(Ativo)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  pessoas              Pessoa[]
  produtosResponsaveis Produto[]
  integracoes          Integracao[]

  @@index([projetoId])
  @@index([status])
  @@map("times")
}

enum PessoaStatus {
  Ativo
  Inativo

  @@map("pessoa_status")
}

model Pessoa {
  id                String       @id @default(cuid())
  projetoId         String       @map("projeto_id")
  projeto           Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome              String
  emailCorporativo  String?      @map("email_corporativo")
  papel             String?
  cargo             String?
  timeId            String?      @map("time_id")
  time              Time?        @relation(fields: [timeId], references: [id])
  produtos          String[]     @default([])
  responsabilidades String[]     @default([])
  especialidades    String[]     @default([])
  nivelDecisao      String?      @map("nivel_decisao")
  pessoaReferencia  Boolean      @default(false) @map("pessoa_referencia")
  observacoes       String?
  status            PessoaStatus @default(Ativo)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([projetoId])
  @@index([timeId])
  @@index([status])
  @@map("pessoas")
}

enum ProdutoStatus {
  Ativo
  Planejamento
  Inativo

  @@map("produto_status")
}

model Produto {
  id                     String        @id @default(cuid())
  projetoId              String        @map("projeto_id")
  projeto                Projeto       @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome                   String
  nomeCurto              String?       @map("nome_curto")
  codigo                 String
  status                 ProdutoStatus @default(Planejamento)
  descricao              String?
  objetivo               String?
  problemaResolve        String?       @map("problema_resolve")
  usuariosPrincipais     String?       @map("usuarios_principais")
  areaNegocio            String?       @map("area_negocio")
  areasBeneficiadas      String[]      @default([]) @map("areas_beneficiadas")
  timeResponsavelId      String?       @map("time_responsavel_id")
  timeResponsavel        Time?         @relation(fields: [timeResponsavelId], references: [id])
  responsavelPrincipal   String?       @map("responsavel_principal")
  ambientes              String[]      @default([])
  paises                 String[]      @default([])
  observacoes            String?
  estabilidadeStatus     String        @default("Em Desenvolvimento") @map("estabilidade_status")
  estabilidadeObservacao String?       @map("estabilidade_observacao")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  publicosAlvo            PublicoAlvo[]
  modulos                 Modulo[]
  funcionalidades         Funcionalidade[]
  jornadas                Jornada[]
  jornadasParticipantes   Jornada[]        @relation("JornadaProdutosParticipantes")
  regras                  Regra[]
  integracoes             Integracao[]     @relation("IntegracaoProduto")
  integracoesRelacionadas Integracao[]     @relation("IntegracaoProdutoRelacionado")

  @@unique([projetoId, codigo])
  @@index([projetoId])
  @@index([status])
  @@index([timeResponsavelId])
  @@map("produtos")
}

enum PublicoAlvoStatus {
  Ativo
  Inativo

  @@map("publico_alvo_status")
}

model PublicoAlvo {
  id                 String            @id @default(cuid())
  produtoId          String            @map("produto_id")
  produto            Produto           @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome               String
  status             PublicoAlvoStatus @default(Ativo)
  perfil             String?
  tipoUsuario        String?           @map("tipo_usuario")
  descricao          String?
  necessidades       String[]          @default([])
  dores              String[]          @default([])
  objetivos          String[]          @default([])
  frequenciaUso      String?           @map("frequencia_uso")
  canaisUtilizados   String[]          @default([]) @map("canais_utilizados")
  paisesOndeSeAplica String[]          @default([]) @map("paises_onde_se_aplica")
  observacoes        String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  jornadas Jornada[]

  @@index([produtoId])
  @@index([status])
  @@map("publico_alvo")
}

enum ModuloStatus {
  Ativo
  Inativo

  @@map("modulo_status")
}

model Modulo {
  id                   String       @id @default(cuid())
  produtoId            String       @map("produto_id")
  produto              Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome                 String
  codigo               String
  status               ModuloStatus @default(Ativo)
  descricao            String?
  objetivo             String?
  responsavelPrincipal String?      @map("responsavel_principal")
  ordemExibicao        Int?         @map("ordem_exibicao")
  observacoes          String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  funcionalidades Funcionalidade[]
  jornadas        Jornada[]        @relation("JornadaModulos")
  regras          Regra[]          @relation("RegraModulos")

  @@unique([produtoId, codigo])
  @@index([produtoId])
  @@index([status])
  @@map("modulos")
}

enum FuncionalidadeStatus {
  Ativo
  Inativo

  @@map("funcionalidade_status")
}

model Funcionalidade {
  id                    String               @id @default(cuid())
  produtoId             String               @map("produto_id")
  produto               Produto              @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome                  String
  codigo                String
  moduloId              String?              @map("modulo_id")
  modulo                Modulo?              @relation(fields: [moduloId], references: [id])
  status                FuncionalidadeStatus @default(Ativo)
  descricao             String?
  objetivo              String?
  comportamentoEsperado String?              @map("comportamento_esperado")
  usuarios              String?
  responsavelPrincipal  String?              @map("responsavel_principal")
  observacoes           String?
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  jornadas    Jornada[]    @relation("JornadaFuncionalidades")
  regras      Regra[]      @relation("RegraFuncionalidades")
  integracoes Integracao[] @relation("IntegracaoFuncionalidades")

  @@unique([produtoId, codigo])
  @@index([produtoId])
  @@index([status])
  @@index([moduloId])
  @@map("funcionalidades")
}

enum JornadaStatus {
  Ativo
  Inativo

  @@map("jornada_status")
}

model Jornada {
  id                String        @id @default(cuid())
  produtoId         String        @map("produto_id")
  produto           Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome              String
  status            JornadaStatus @default(Ativo)
  descricao         String?
  publicoAlvoId     String?       @map("publico_alvo_id")
  publicoAlvo       PublicoAlvo?  @relation(fields: [publicoAlvoId], references: [id])
  objetivo          String?
  eventoInicial     String?       @map("evento_inicial")
  resultadoEsperado String?       @map("resultado_esperado")
  etapas            String[]      @default([])
  paises            String[]      @default([])
  observacoes       String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  modulos               Modulo[]         @relation("JornadaModulos")
  funcionalidades       Funcionalidade[] @relation("JornadaFuncionalidades")
  produtosParticipantes Produto[]        @relation("JornadaProdutosParticipantes")
  regras                Regra[]          @relation("RegraJornadas")

  @@index([produtoId])
  @@index([status])
  @@index([publicoAlvoId])
  @@map("jornadas")
}

enum RegraStatus {
  Ativo
  Inativo

  @@map("regra_status")
}

model Regra {
  id                String      @id @default(cuid())
  produtoId         String      @map("produto_id")
  produto           Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  grupoId           String      @map("grupo_id")
  numeroVersao      Int         @default(1) @map("numero_versao")
  versaoAtual       Boolean     @default(true) @map("versao_atual")
  nome              String
  status            RegraStatus @default(Ativo)
  condicao          String?
  resultadoEsperado String?     @map("resultado_esperado")
  excecoes          String[]    @default([])
  exemplos          String[]    @default([])
  prioridade        String?
  vigenciaInicio    DateTime?   @map("vigencia_inicio") @db.Date
  vigenciaFim       DateTime?   @map("vigencia_fim") @db.Date
  observacoes       String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  modulos         Modulo[]         @relation("RegraModulos")
  funcionalidades Funcionalidade[] @relation("RegraFuncionalidades")
  jornadas        Jornada[]        @relation("RegraJornadas")

  @@index([produtoId])
  @@index([grupoId])
  @@index([status])
  @@map("regras")
}

enum IntegracaoStatus {
  Ativo
  Inativo

  @@map("integracao_status")
}

model Integracao {
  id                   String           @id @default(cuid())
  produtoId            String           @map("produto_id")
  produto              Produto          @relation("IntegracaoProduto", fields: [produtoId], references: [id], onDelete: Cascade)
  nome                 String
  status               IntegracaoStatus @default(Ativo)
  direcao              String?
  papelDependencia     String?          @map("papel_dependencia")
  produtoRelacionadoId String?          @map("produto_relacionado_id")
  produtoRelacionado   Produto?         @relation("IntegracaoProdutoRelacionado", fields: [produtoRelacionadoId], references: [id])
  tipo                 String?
  endpoint             String?
  modo                 String?
  criticidade          String?
  dadosTrafegados      String?          @map("dados_trafegados")
  timeProprietarioId   String?          @map("time_proprietario_id")
  timeProprietario     Time?            @relation(fields: [timeProprietarioId], references: [id])
  observacoes          String?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  funcionalidades Funcionalidade[] @relation("IntegracaoFuncionalidades")

  @@index([produtoId])
  @@index([produtoRelacionadoId])
  @@index([timeProprietarioId])
  @@index([status])
  @@map("integracoes")
}

enum FonteStatus {
  Ativa
  Revisao
  Inativa

  @@map("fonte_status")
}

model FonteConhecimento {
  id                String      @id @default(cuid())
  projetoId         String      @map("projeto_id")
  projeto           Projeto     @relation("FonteProjetoProprietario", fields: [projetoId], references: [id], onDelete: Cascade)
  nome              String
  tipo              String
  referencia        String
  status            FonteStatus @default(Ativa)
  oficial           Boolean     @default(false)
  responsavel       String?
  descricao         String?
  ultimaVerificacao DateTime?   @map("ultima_verificacao") @db.Date
  observacoes       String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  vinculos FonteVinculo[]

  @@unique([projetoId, referencia])
  @@index([projetoId])
  @@index([status])
  @@index([tipo])
  @@map("fontes_conhecimento")
}

model FonteVinculo {
  id                String            @id @default(cuid())
  fonteId           String            @map("fonte_id")
  fonte             FonteConhecimento @relation(fields: [fonteId], references: [id], onDelete: Cascade)
  projetoContextoId String            @map("projeto_contexto_id")
  projetoContexto   Projeto           @relation("FonteVinculoProjetoContexto", fields: [projetoContextoId], references: [id], onDelete: Cascade)
  entityType        String            @map("entity_type")
  entityId          String            @map("entity_id")
  contexto          String?
  createdAt         DateTime          @default(now()) @map("created_at")

  @@unique([fonteId, entityType, entityId])
  @@index([fonteId])
  @@index([projetoContextoId])
  @@index([entityType, entityId])
  @@map("fontes_vinculos")
}

enum DocumentoStatus {
  Rascunho
  Revisao
  Publicado
  Arquivado

  @@map("documento_status")
}

model DocumentoConhecimento {
  id              String          @id @default(cuid())
  projetoId       String          @map("projeto_id")
  projeto         Projeto         @relation("DocumentoProjetoProprietario", fields: [projetoId], references: [id], onDelete: Cascade)
  codigo          String
  titulo          String
  tipo            String
  status          DocumentoStatus @default(Rascunho)
  resumo          String?
  conteudo        String?
  responsavel     String?
  versao          Int             @default(1)
  versaoPublicada Int?            @map("versao_publicada")
  publicadoEm     DateTime?       @map("publicado_em")
  createdByUserId String?         @map("created_by_user_id")
  createdBy       User?           @relation("DocumentoCriadoPor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  versoes  DocumentoVersao[]
  vinculos DocumentoVinculo[]

  @@unique([projetoId, codigo])
  @@index([projetoId])
  @@index([status])
  @@index([tipo])
  @@map("documentos_conhecimento")
}

model DocumentoVersao {
  id              String                @id @default(cuid())
  documentoId     String                @map("documento_id")
  documento       DocumentoConhecimento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  numero          Int
  titulo          String
  resumo          String?
  conteudo        String?
  motivoAlteracao String?               @map("motivo_alteracao")
  createdByUserId String?               @map("created_by_user_id")
  createdBy       User?                 @relation("DocumentoVersaoCriadoPor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now()) @map("created_at")

  @@unique([documentoId, numero])
  @@index([documentoId, createdAt])
  @@map("documentos_versoes")
}

model DocumentoVinculo {
  id                String                @id @default(cuid())
  documentoId       String                @map("documento_id")
  documento         DocumentoConhecimento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  projetoContextoId String                @map("projeto_contexto_id")
  projetoContexto   Projeto               @relation("DocumentoVinculoProjetoContexto", fields: [projetoContextoId], references: [id], onDelete: Cascade)
  entityType        String                @map("entity_type")
  entityId          String                @map("entity_id")
  contexto          String?
  createdAt         DateTime              @default(now()) @map("created_at")

  @@unique([documentoId, entityType, entityId])
  @@index([documentoId])
  @@index([projetoContextoId])
  @@index([entityType, entityId])
  @@map("documentos_vinculos")
}

model HistoryEntry {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  label       String
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("history_entries")
}
